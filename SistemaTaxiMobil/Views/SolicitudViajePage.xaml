<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:SistemaTaxiMobil.ViewModels"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="SistemaTaxiMobil.Views.SolicitudViajePage"
             x:DataType="viewmodel:SolicitudViajeViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">

        <!-- Mapa -->
        <maps:Map x:Name="mapa"
                  Grid.Row="0"
                  IsShowingUser="True"
                  MapType="Street"/>

        <!-- Panel inferior -->
        <Frame Grid.Row="1"
               CornerRadius="20,20,0,0"
               Padding="20"
               HasShadow="True"
               BackgroundColor="White">
            <VerticalStackLayout Spacing="15">

                <!-- Origen -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Ellipse Grid.Column="0"
                             Fill="{StaticResource PrimaryColor}"
                             WidthRequest="12"
                             HeightRequest="12"
                             VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="{Binding DireccionOrigen}"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="2"
                            Text="📍"
                            Command="{Binding SeleccionarOrigenCommand}"
                            BackgroundColor="Transparent"
                            FontSize="20"/>
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource LightGray}"/>

                <!-- Destino -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Rectangle Grid.Column="0"
                               Fill="{StaticResource AccentColor}"
                               WidthRequest="12"
                               HeightRequest="12"
                               VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="{Binding DireccionDestino}"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="2"
                            Text="📍"
                            Command="{Binding SeleccionarDestinoCommand}"
                            BackgroundColor="Transparent"
                            FontSize="20"/>
                </Grid>

                <!-- Información del viaje -->
                <Frame BorderColor="{StaticResource LightGray}"
                       IsVisible="{Binding DistanciaKm, Converter={StaticResource IsGreaterThanZeroConverter}}"
                       Padding="15"
                       Margin="0,10,0,0">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding DistanciaKm, StringFormat='{0:F2} km'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="Distancia"
                                   FontSize="12"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding DuracionMinutos, StringFormat='{0:F0} min'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="Tiempo"
                                   FontSize="12"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="{Binding CostoEstimado, StringFormat='${0:F2}'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource PrimaryColor}"/>
                            <Label Text="Costo"
                                   FontSize="12"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Método de pago -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="💳"
                           FontSize="24"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="{Binding MetodoPago}"
                           FontSize="16"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Botón solicitar -->
                <Button 
                    Text="Solicitar Viaje"
                    Command="{Binding SolicitarViajeCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

                <ActivityIndicator 
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource PrimaryColor}"/>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>