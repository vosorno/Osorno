<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:SistemaTaxiMobil.ViewModels"
             x:Class="SistemaTaxiMobil.Views.RegistroUsuarioPage"
             x:DataType="viewmodel:RegistroUsuarioViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label 
                Text="Crear Usuario"
                Style="{StaticResource TitleLabel}"
                Margin="0,20,0,20"/>

            <Label 
                Text="Ingrese sus datos de usuario"
                FontSize="16"
                TextColor="Gray"
                HorizontalOptions="Center"/>

            <Frame BorderColor="{StaticResource LightGray}" 
                   CornerRadius="10"
                   Padding="0"
                   Margin="0,20,0,0">
                <VerticalStackLayout Spacing="0">
                    <Entry 
                        Placeholder="Usuario"
                        Text="{Binding Usuario}"
                        Style="{StaticResource EntryStyle}"/>

                    <BoxView HeightRequest="1" Color="{StaticResource LightGray}"/>

                    <Entry 
                        Placeholder="Contraseña"
                        Text="{Binding Password}"
                        IsPassword="True"
                        Style="{StaticResource EntryStyle}"/>

                    <BoxView HeightRequest="1" Color="{StaticResource LightGray}"/>

                    <Entry 
                        Placeholder="Confirmar Contraseña"
                        Text="{Binding ConfirmarPassword}"
                        IsPassword="True"
                        Style="{StaticResource EntryStyle}"/>
                </VerticalStackLayout>
            </Frame>

            <Button 
                Text="Registrar"
                Command="{Binding RegistrarCommand}"
                Style="{StaticResource PrimaryButton}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                Margin="0,30,0,0"/>

            <ActivityIndicator 
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource PrimaryColor}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>